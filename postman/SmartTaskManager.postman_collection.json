{
  "info": {
    "name": "Smart Task Manager 3D API",
    "description": "Import into Postman. Set baseUrl=http://localhost:8080 and token after login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"demo\",\"email\":\"demo@mail.com\",\"password\":\"demo1234\"}" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"usernameOrEmail\":\"demo@mail.com\",\"password\":\"demo1234\"}" }
          }
        },
        { "name": "Health (no auth)", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/tasks", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"Prepare demo\",\"description\":\"slides + rehearsal\",\"priority\":\"High\",\"deadline\":\"2026-10-20\",\"status\":\"TODO\",\"category\":\"College\",\"estimatedMinutes\":60}" }
          }
        },
        {
          "name": "Patch status",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/1/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\"status\":\"IN_PROGRESS\"}" }
          }
        },
        { "name": "Duplicate", "request": { "method": "POST", "url": "{{baseUrl}}/api/tasks/1/duplicate", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/tasks/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Dashboard & Analytics",
      "item": [
        { "name": "Summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/summary", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Productivity", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/productivity", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Assistant daily plan", "request": { "method": "GET", "url": "{{baseUrl}}/api/assistant/daily-plan", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
      "name": "Projects",
      "item": [
        { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/projects", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/projects",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"College Demo\",\"color\":\"#a78bfa\",\"icon\":\"🎓\"}" }
          }
        }
      ]
    },
    {
      "name": "Focus / Notifications / Achievements / Demo",
      "item": [
        {
          "name": "Record focus session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/focus-sessions",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\"kind\":\"FOCUS\",\"minutesPlanned\":25,\"minutesActual\":25}" }
          }
        },
        { "name": "Notifications", "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Achievements", "request": { "method": "GET", "url": "{{baseUrl}}/api/achievements", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Demo seed", "request": { "method": "POST", "url": "{{baseUrl}}/api/demo/seed", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Demo reset", "request": { "method": "POST", "url": "{{baseUrl}}/api/demo/reset", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    }
  ]
}
